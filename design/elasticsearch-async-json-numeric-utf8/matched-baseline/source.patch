+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# Copyright Red Hat Inc. and Hibernate Authors
+"""Summarize jfr print --json execution/native samples; counts are not exact CPU fractions."""
+import argparse
+from collections import Counter
+import hashlib
+import json
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('samples', type=Path)
+    parser.add_argument('--thread', default='searchParser-jmh-worker', help='sampled thread name substring')
+    args = parser.parse_args()
+    data = args.samples.read_bytes()
+    events = json.loads(data)['recording']['events']
+    top, inclusive, stacks = Counter(), Counter(), Counter()
+    selected = empty = truncated = 0
+    for event in events:
+        if event['type'] not in {'jdk.ExecutionSample', 'jdk.NativeMethodSample'}:
+            continue
+        values = event['values']
+        thread = values.get('sampledThread') or values.get('eventThread') or {}
+        if args.thread not in thread.get('javaName', ''):
+            continue
+        trace = values.get('stackTrace') or {}
+        frames = trace.get('frames') or []
+        names = [frame['method']['type']['name'].replace('/', '.') + '.' + frame['method']['name']
+                 for frame in frames]
+        if not names:
+            empty += 1
+            continue
+        selected += 1
+        truncated += bool(trace.get('truncated'))
+        top[names[0]] += 1
+        inclusive.update(set(names))
+        stacks[tuple(names)] += 1
+    print('Execution/native samples; diagnostic counts, not exact CPU fractions.')
+    print('Input:', args.samples)
+    print('Input SHA-256:', hashlib.sha256(data).hexdigest())
+    print('Thread substring:', args.thread)
+    print(f'Total events: {len(events)}; selected stacks: {selected}; empty: {empty}; truncated: {truncated}')
+    for label, counts in [('Top frame', top), ('Inclusive (one count per frame name per sample)', inclusive)]:
+        print('\n' + label)
+        for name, count in counts.most_common():
+            print(f'{count:5} {name}')
+    print('\nAll unique selected stacks (count followed by full frame names)')
+    for frames, count in stacks.most_common():
+        print(f'\n{count} samples')
+        print('\n'.join('  ' + name for name in frames))
+
+
+if __name__ == '__main__':
+    main()
