new file mode 100644
index 0000000000..8933dd1c44
--- /dev/null
+++ b/integrationtest/performance/backend/elasticsearch/src/main/java/org/hibernate/search/integrationtest/performance/backend/elasticsearch/JsonComparisonBenchmark.java
@@ -0,0 +1,181 @@
+package org.hibernate.search.integrationtest.performance.backend.elasticsearch;
+
+import java.nio.ByteBuffer;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+
+import org.hibernate.search.backend.elasticsearch.client.common.gson.entity.spi.GsonHttpEntityContentProvider;
+import org.hibernate.search.backend.elasticsearch.client.common.json.impl.ElasticsearchJsonBody;
+import org.hibernate.search.util.json.JsonElement;
+import org.hibernate.search.util.json.spi.JsonBody;
+import org.hibernate.search.util.json.spi.JsonParsing;
+
+import org.openjdk.jmh.annotations.Benchmark;
+import org.openjdk.jmh.annotations.BenchmarkMode;
+import org.openjdk.jmh.annotations.Fork;
+import org.openjdk.jmh.annotations.Measurement;
+import org.openjdk.jmh.annotations.Mode;
+import org.openjdk.jmh.annotations.OutputTimeUnit;
+import org.openjdk.jmh.annotations.Param;
+import org.openjdk.jmh.annotations.Scope;
+import org.openjdk.jmh.annotations.Setup;
+import org.openjdk.jmh.annotations.State;
+import org.openjdk.jmh.annotations.TearDown;
+import org.openjdk.jmh.annotations.Warmup;
+
+/** Complete NDJSON writes. Fresh includes construction/probe; reused excludes them for every writer. */
+@BenchmarkMode(Mode.Throughput)
+@OutputTimeUnit(TimeUnit.SECONDS)
+@Warmup(iterations = 5, time = 1)
+@Measurement(iterations = 5, time = 1)
+@Fork(3)
+public class JsonComparisonBenchmark {
+	@State(Scope.Thread)
+	public static class Bodies extends JsonBenchmarkFixtures {
+		@Param({ "small", "mapping", "unicode", "nested", "scalar-1m", "scalar-8m", "bulk-10000" })
+		public String fixture;
+		@Param({ "fresh", "reused" })
+		public String lifecycle;
+		List<JsonElement> searchParts;
+		JsonBody body;
+		GsonHttpEntityContentProvider provider;
+		JsonBoundedWorker worker;
+		final ByteBuffer buffer = ByteBuffer.allocate( 8192 );
+		final JsonParsing parsing = new JsonParsing();
+
+		@Setup
+		@Override
+		public void setup() {
+			super.fixture = fixture;
+			super.setup();
+			JsonBenchmarkSupport.verifyAffinity();
+			try {
+				searchParts = JsonBenchmarkSupport.convert( this );
+				body = ElasticsearchJsonBody.ndjson( searchParts );
+				provider = new GsonHttpEntityContentProvider( gson, parts );
+				worker = new JsonBoundedWorker();
+				JsonBenchmarkSupport.verify( this, searchParts, worker );
+			}
+			catch (Exception e) {
+				throw new IllegalStateException( e );
+			}
+		}
+
+		JsonBody selectedBody() {
+			return "fresh".equals( lifecycle ) ? ElasticsearchJsonBody.ndjson( searchParts ) : body;
+		}
+
+		@TearDown
+		public void close() throws Exception {
+			worker.close();
+		}
+	}
+
+	@Benchmark
+	public long gson(Bodies state) throws Exception {
+		var sink = new JsonBenchmarkSupport.Sink();
+		GsonHttpEntityContentProvider provider = "fresh".equals( state.lifecycle )
+				? new GsonHttpEntityContentProvider( state.gson, state.parts )
+				: state.provider;
+		provider.writeTo( sink );
+		return sink.result() ^ provider.getContentLength();
+	}
+
+	@Benchmark
+	public long jackson(Bodies state) throws Exception {
+		JsonBody body = state.selectedBody();
+		var sink = new JsonBenchmarkSupport.Sink();
+		JsonBenchmarkSupport.jackson( state.searchParts, sink );
+		return sink.result() ^ body.contentLength();
+	}
+
+	@Benchmark
+	public long synchronousCursor(Bodies state) throws Exception {
+		JsonBody body = state.selectedBody();
+		var sink = new JsonBenchmarkSupport.Sink();
+		body.writeTo( sink );
+		return sink.result() ^ body.contentLength();
+	}
+
+	@Benchmark
+	public long incrementalCursor(Bodies state) throws Exception {
+		JsonBody body = state.selectedBody();
+		var sink = new JsonBenchmarkSupport.Sink();
+		JsonBenchmarkSupport.incremental( body, sink, state.buffer );
+		return sink.result() ^ body.contentLength();
+	}
+
+	@Benchmark
+	public long boundedWorker(Bodies state) throws Exception {
+		JsonBody body = state.selectedBody();
+		var sink = new JsonBenchmarkSupport.Sink();
+		state.worker.write( output -> JsonBenchmarkSupport.jackson( state.searchParts, output ), sink );
+		return sink.result() ^ body.contentLength();
+	}
+
+	@Benchmark
+	public JsonElement searchParser(Bodies state) {
+		return state.parsing.parse( state.json );
+	}
+
+	@Benchmark
+	public Object gsonParser(Bodies state) {
+		return state.gson.fromJson( state.json, com.google.gson.JsonObject.class );
+	}
+
+	@State(Scope.Thread)
+	public static class Accessors {
+		final org.hibernate.search.backend.elasticsearch.gson.impl.JsonAccessor<Long> gsonAccessor =
+				org.hibernate.search.backend.elasticsearch.gson.impl.JsonAccessor.root()
+						.property( "hits" ).property( "total" ).property( "value" ).asLong();
+		final org.hibernate.search.util.json.spi.JsonAccessor<Long> strict =
+				org.hibernate.search.util.json.spi.JsonAccessor.root().property( "hits" ).property( "total" )
+						.property( "value" ).asLong();
+		final org.hibernate.search.util.json.spi.JsonAccessor<Long> adapted =
+				org.hibernate.search.util.json.spi.JsonAccessor.root().property( "hits" ).unwrapSingletonArrays()
+						.property( "total" ).unwrapSingletonArrays().property( "value" ).unwrapSingletonArrays().asLong();
+		final String plain = "{\"hits\":{\"total\":{\"value\":42}}}";
+		final String arrays = "{\"hits\":[[{\"total\":[{\"value\":[[42]]}]}]]}";
+		final com.google.gson.JsonObject gsonPlain =
+				new com.google.gson.Gson().fromJson( plain, com.google.gson.JsonObject.class );
+		final com.google.gson.JsonObject gsonArrays =
+				new com.google.gson.Gson().fromJson( arrays, com.google.gson.JsonObject.class );
+		final org.hibernate.search.util.json.JsonObject searchPlain = new JsonParsing().parse( plain ).getAsJsonObject();
+		final org.hibernate.search.util.json.JsonObject searchArrays = new JsonParsing().parse( arrays ).getAsJsonObject();
+
+		@Setup
+		public void verify() {
+			JsonBenchmarkSupport.verifyAffinity();
+			if ( gsonAccessor.get( gsonPlain ).orElseThrow() != 42
+					|| gsonAccessor.get( gsonArrays ).orElseThrow() != 42
+					|| strict.get( searchPlain ).orElseThrow() != 42 || adapted.get( searchArrays ).orElseThrow() != 42 ) {
+				throw new IllegalStateException( "Accessor mismatch" );
+			}
+		}
+	}
+
+	@Benchmark
+	public long gsonAccessor(Accessors state) {
+		return state.gsonAccessor.get( state.gsonPlain ).orElseThrow();
+	}
+
+	@Benchmark
+	public long gsonAdaptedAccessor(Accessors state) {
+		return state.gsonAccessor.get( state.gsonArrays ).orElseThrow();
+	}
+
+	@Benchmark
+	public long searchAccessor(Accessors state) {
+		return state.strict.get( state.searchPlain ).orElseThrow();
+	}
+
+	@Benchmark
+	public long searchAdaptedAccessor(Accessors state) {
+		return state.adapted.get( state.searchArrays ).orElseThrow();
+	}
+
+	@Benchmark
+	public JsonParsing initializeParser(JsonBenchmarkAffinity affinity) {
+		return new JsonParsing();
+	}
+}
diff --git a/integrationtest/performance/backend/elasticsearch/src/main/java/org/hibernate/search/integrationtest/performance/backend/elasticsearch/JsonSlowConsumerHarness.java b/integrationtest/performance/backend/elasticsearch/src/main/java/org/hibernate/search/integrationtest/performance/backend/elasticsearch/JsonSlowConsumerHarness.java
new file mode 100644
index 0000000000..4f27581f2f
--- /dev/null
+++ b/integrationtest/performance/backend/elasticsearch/src/main/java/org/hibernate/search/integrationtest/performance/backend/elasticsearch/JsonSlowConsumerHarness.java
@@ -0,0 +1,141 @@
+package org.hibernate.search.integrationtest.performance.backend.elasticsearch;
+
+import java.io.ByteArrayOutputStream;
+import java.io.FileDescriptor;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.OutputStream;
+import java.io.PrintWriter;
+import java.lang.management.ManagementFactory;
+import java.lang.management.ThreadMXBean;
+import java.lang.reflect.Field;
+import java.nio.ByteBuffer;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Locale;
+import java.util.concurrent.locks.LockSupport;
+
+import org.hibernate.search.backend.elasticsearch.client.common.json.impl.ElasticsearchJsonBody;
+import org.hibernate.search.util.json.spi.JsonBodies;
+import org.hibernate.search.util.json.spi.JsonWriteCursor;
+
+/** Independent exact-byte/retention/cancellation assertions and untimed slow-consumer diagnostics. */
+public final class JsonSlowConsumerHarness {
+	private JsonSlowConsumerHarness() {
+	}
+
+	public static void main(String[] args) throws Exception {
+		PrintWriter output = new PrintWriter( new FileOutputStream( FileDescriptor.out ), true, StandardCharsets.UTF_8 );
+		JsonBenchmarkSupport.verifyAffinity();
+		output.println(
+				"fixture,encodedBytes,cursorEncodedBound,workerArrayBound,slowWallMs,totalCpuMs,workerCpuMs,workerBusyMs,workerCpuOccupancy" );
+		ThreadMXBean threads = ManagementFactory.getThreadMXBean();
+		threads.setThreadCpuTimeEnabled( true );
+		for ( String name : new String[] { "small", "mapping", "unicode", "nested", "scalar-1m", "scalar-8m", "bulk-10000" } ) {
+			JsonBenchmarkFixtures fixture = new JsonBenchmarkFixtures();
+			fixture.fixture = name;
+			fixture.setup();
+			var parts = JsonBenchmarkSupport.convert( fixture );
+			var body = ElasticsearchJsonBody.ndjson( parts );
+			byte[] expected = JsonBenchmarkSupport.bytes( body::writeTo );
+			try ( JsonBoundedWorker worker = new JsonBoundedWorker() ) {
+				JsonBenchmarkSupport.verify( fixture, parts, worker );
+				if ( worker.encodedCapacity() != 16384 ) {
+					throw new IllegalStateException( "Worker storage bound changed" );
+				}
+				for ( int capacity : new int[] { 1, 2, 5, 8192 } ) {
+					byte[] actual = JsonBenchmarkSupport
+							.bytes( sink -> JsonBenchmarkSupport.incremental( body, sink, ByteBuffer.allocate( capacity ) ) );
+					if ( !Arrays.equals( expected, actual ) ) {
+						throw new IllegalStateException( "Capacity mismatch " + capacity );
+					}
+				}
+				for ( var part : parts ) {
+					try ( JsonWriteCursor cursor = JsonBodies.openCursor( part ) ) {
+						if ( cursor.write( ByteBuffer.allocate( 0 ) ) != 0 ) {
+							throw new IllegalStateException( "Zero capacity progress" );
+						}
+						cursor.write( ByteBuffer.allocate( 5 ) );
+						Field field = cursor.getClass().getDeclaredField( "pending" );
+						field.setAccessible( true );
+						byte[] pending = (byte[]) field.get( cursor );
+						if ( pending != null && pending.length > 6 ) {
+							throw new IllegalStateException( "Unbounded cursor" );
+						}
+						cursor.close();
+						if ( field.get( cursor ) != null ) {
+							throw new IllegalStateException( "Cancelled cursor retains encoded output" );
+						}
+					}
+				}
+				ByteArrayOutputStream received = new ByteArrayOutputStream();
+				long cpuBefore = cpu( threads );
+				long start = System.nanoTime();
+				long[] workerTime = new long[2];
+				worker.write( sink -> {
+					long workerStart = System.nanoTime();
+					long workerCpu = threads.getCurrentThreadCpuTime();
+					JsonBenchmarkSupport.jackson( parts, sink );
+					workerTime[0] = threads.getCurrentThreadCpuTime() - workerCpu;
+					workerTime[1] = System.nanoTime() - workerStart;
+				}, new OutputStream() {
+					@Override
+					public void write(int value) {
+						received.write( value );
+					}
+
+					@Override
+					public void write(byte[] bytes, int offset, int length) {
+						LockSupport.parkNanos( 100_000 );
+						received.write( bytes, offset, length );
+					}
+				} );
+				long wall = System.nanoTime() - start;
+				long cpu = cpu( threads ) - cpuBefore;
+				if ( !Arrays.equals( expected, received.toByteArray() ) ) {
+					throw new IllegalStateException( "Slow consumer incomplete" );
+				}
+				output.printf( Locale.ROOT, "%s,%d,6,16384,%.3f,%.3f,%.3f,%.3f,%.3f%n", name, expected.length,
+						wall / 1e6, cpu / 1e6, workerTime[0] / 1e6, workerTime[1] / 1e6, (double) workerTime[0] / wall );
+			}
+			try ( JsonBoundedWorker worker = new JsonBoundedWorker() ) {
+				try {
+					worker.write( sink -> JsonBenchmarkSupport.jackson( parts, sink ), new OutputStream() {
+						@Override
+						public void write(int value) throws IOException {
+							throw new IOException( "intentional consumer cancellation" );
+						}
+
+						@Override
+						public void write(byte[] bytes, int offset, int length) throws IOException {
+							throw new IOException( "intentional consumer cancellation" );
+						}
+					} );
+					throw new IllegalStateException( "Consumer failure ignored" );
+				}
+				catch (IOException expectedFailure) {
+					// close cancels any blocked producer and asserts termination.
+				}
+			}
+		}
+		// Lone surrogates intentionally differ from legacy UTF-8 replacement; outside byte-equivalent fixtures.
+		var lone = new org.hibernate.search.util.json.JsonObject();
+		lone.addProperty( "text", "\ud800" );
+		String loneOutput = new String( JsonBenchmarkSupport.bytes( JsonBodies.of( lone )::writeTo ), StandardCharsets.UTF_8 );
+		if ( !"{\"text\":\"\\ud800\"}".equals( loneOutput ) ) {
+			throw new IllegalStateException( "Surrogate policy mismatch" );
+		}
+		output.println( "All full-byte, capacity, cancellation and surrogate-policy assertions passed." );
+	}
+
+	private static long cpu(ThreadMXBean threads) {
+		long total = 0;
+		for ( long id : threads.getAllThreadIds() ) {
+			long value = threads.getThreadCpuTime( id );
+			if ( value > 0 ) {
+				total += value;
+			}
+		}
+		return total;
+	}
+}
diff --git a/integrationtest/performance/backend/scripts/json-benchmark-runner.py b/integrationtest/performance/backend/scripts/json-benchmark-runner.py
new file mode 100644
index 0000000000..0b31b69bb1
--- /dev/null
+++ b/integrationtest/performance/backend/scripts/json-benchmark-runner.py
@@ -0,0 +1,184 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# Copyright Red Hat Inc. and Hibernate Authors
+"""Linux-only controlled runner. Never changes host settings or downloads executables."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import time
+
+ROOT = Path(__file__).resolve().parents[4]
+JAR = ROOT / 'integrationtest/performance/backend/elasticsearch/target/benchmarks.jar'
+
+
+def read(path):
+    try:
+        return Path(path).read_text().strip()
+    except (OSError, UnicodeError):
+        return 'unavailable'
+
+
+def capture(command):
+    result = subprocess.run(command, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
+    return result.stdout.strip()
+
+
+def positive(value):
+    number = int(value)
+    if number < 1:
+        raise argparse.ArgumentTypeError('must be positive')
+    return number
+
+
+def cores(spec):
+    result = set()
+    for component in spec.split(','):
+        limits = component.split('-')
+        if len(limits) == 1:
+            result.add(int(limits[0]))
+        elif len(limits) == 2:
+            low, high = map(int, limits)
+            if low > high:
+                raise ValueError('reversed CPU range')
+            result.update(range(low, high + 1))
+        else:
+            raise ValueError('invalid CPU range')
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--cores', help='allowed online CPUs, e.g. 0,2 (two distinct physical cores recommended)')
+    parser.add_argument('--out', required=True, type=Path)
+    parser.add_argument('--skip-build', action='store_true')
+    parser.add_argument('--forks', type=positive, default=3)
+    parser.add_argument('--warmup', type=positive, default=5)
+    parser.add_argument('--iterations', type=positive, default=5)
+    parser.add_argument('--seconds', type=positive, default=1)
+    parser.add_argument('--quick', action='store_true', help='non-gating: one fork, one warmup/measurement')
+    parser.add_argument('--cold', action='store_true', help='non-gating: one un-warmed single-shot factory invocation per fork')
+    parser.add_argument('--pattern', default='JsonComparisonBenchmark.(gson|jackson|synchronousCursor|incrementalCursor|boundedWorker)$')
+    parser.add_argument('--fixtures', default='small,mapping,unicode,nested,scalar-1m,scalar-8m,bulk-10000')
+    parser.add_argument('--lifecycle', choices=['fresh', 'reused'], default='fresh')
+    parser.add_argument('--profiler', help='optional JMH profiler specification; separate diagnostic run')
+    parser.add_argument('--jvm-args', default='', help='additional fork JVM arguments (recorded verbatim)')
+    args = parser.parse_args()
+    if args.quick and args.cold:
+        parser.error('--quick and --cold are mutually exclusive')
+    if not os.sys.platform.startswith('linux'):
+        parser.error('Linux is required for affinity verification')
+    allowed = os.sched_getaffinity(0)
+    online = cores(read('/sys/devices/system/cpu/online'))
+    topology = []
+    for cpu in sorted(allowed & online):
+        base = f'/sys/devices/system/cpu/cpu{cpu}'
+        topology.append(dict(cpu=cpu, socket=read(base + '/topology/physical_package_id'),
+                             core=read(base + '/topology/core_id'), siblings=read(base + '/topology/thread_siblings_list'),
+                             core_type=read(base + '/topology/core_type'),
+                             max_frequency=read(base + '/cpufreq/cpuinfo_max_freq'),
+                             base_frequency=read(base + '/cpufreq/base_frequency'),
+                             governor=read(base + '/cpufreq/scaling_governor'),
+                             current_frequency=read(base + '/cpufreq/scaling_cur_freq')))
+    if args.cores:
+        selected = cores(args.cores)
+    else:
+        # Same topology class/frequency, one logical CPU per physical core.
+        groups = {}
+        seen = set()
+        for entry in topology:
+            identity = (entry['socket'], entry['core'])
+            if identity in seen:
+                continue
+            seen.add(identity)
+            key = (entry['core_type'], entry['max_frequency'])
+            groups.setdefault(key, []).append(entry['cpu'])
+        group = max(groups.values(), key=len)
+        selected = set(group[:2])
+    if not selected or not selected <= (allowed & online):
+        parser.error('selected CPUs must be online and in process affinity')
+    if len(selected) < 2 and 'boundedWorker' in args.pattern:
+        parser.error('worker comparison requires at least two allowed CPUs')
+    args.out.mkdir(parents=True, exist_ok=False)
+    if not args.skip_build:
+        with (args.out / 'build.log').open('w') as output:
+            subprocess.run([str(ROOT / 'mvnw'), 'clean', 'install', '-pl',
+                            'integrationtest/performance/backend/elasticsearch', '-am', '-DskipTests',
+                            '-DskipITs', '-Dno-build-cache'], cwd=ROOT, stdout=output, stderr=subprocess.STDOUT, check=True)
+    if not JAR.is_file():
+        parser.error('missing benchmark JAR; build first or omit --skip-build')
+    if args.skip_build:
+        newest = max(p.stat().st_mtime_ns
+                     for directory in ['util/json/src/main', 'backend/elasticsearch/src/main',
+                                       'integrationtest/performance/backend/elasticsearch/src/main']
+                     for p in (ROOT / directory).rglob('*.java'))
+        if newest > JAR.stat().st_mtime_ns:
+            parser.error('benchmark JAR predates source changes; rebuild before --skip-build')
+    affinity = capture(['taskset', '-c', ','.join(map(str, sorted(selected))), 'sh', '-c',
+                        "sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' /proc/self/status"])
+    jvm = f'-Xms1g -Xmx1g -XX:+UseG1GC -XX:ActiveProcessorCount={len(selected)} -Djson.benchmark.cores={affinity} {args.jvm_args}'.strip()
+    if args.quick:
+        args.forks = args.warmup = args.iterations = 1
+    if args.cold:
+        args.warmup = 0
+        args.iterations = 1
+    command = ['taskset', '-c', affinity, 'java', '-jar', str(JAR), args.pattern,
+               '-f', str(args.forks), '-wi', str(args.warmup), '-i', str(args.iterations),
+               '-w', f'{args.seconds}s', '-r', f'{args.seconds}s', '-t', '1', '-jvmArgs', jvm,
+               '-rf', 'json', '-rff', str(args.out.resolve() / 'jmh.json')]
+    if args.cold:
+        command += ['-bm', 'ss']
+    if args.fixtures:
+        command += ['-p', f'fixture={args.fixtures}', '-p', f'lifecycle={args.lifecycle}']
+    if args.profiler:
+        command += ['-prof', args.profiler]
+    patch = capture(['git', '-C', str(ROOT), 'diff', 'HEAD', '--binary'])
+    untracked = capture(['git', '-C', str(ROOT), 'ls-files', '--others', '--exclude-standard', '--',
+                         'integrationtest/performance/backend/elasticsearch/src',
+                         'integrationtest/performance/backend/scripts', 'util/json/src'])
+    for source in untracked.splitlines():
+        patch += '\n' + capture(['git', '-C', str(ROOT), 'diff', '--no-index', '--binary', '--', '/dev/null', source])
+    (args.out / 'source.patch').write_text(patch + '\n')
+    environment = dict(timestamp=time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),
+                       gating=not args.quick and not args.profiler and not args.cold, command=command,
+                       invocation=shlex.join(os.sys.argv), jvm=jvm,
+                       revision=capture(['git', '-C', str(ROOT), 'rev-parse', 'HEAD']),
+                       status=capture(['git', '-C', str(ROOT), 'status', '--short']),
+                       patch_sha256=hashlib.sha256((patch + '\n').encode()).hexdigest(),
+                       artifact_sha256=hashlib.sha256(JAR.read_bytes()).hexdigest(),
+                       java=capture(['java', '-version']), uname=capture(['uname', '-a']),
+                       cpu=capture(['lscpu']), topology=topology, allowed=sorted(allowed), selected=sorted(selected),
+                       cgroup=read('/proc/self/cgroup'), cpu_max=read('/sys/fs/cgroup/cpu.max'),
+                       cpu_stat_before=read('/sys/fs/cgroup/cpu.stat'), memory_max=read('/sys/fs/cgroup/memory.max'),
+                       cpuset=read('/sys/fs/cgroup/cpuset.cpus.effective'),
+                       load_before=read('/proc/loadavg'), pressure_before=read('/proc/pressure/cpu'),
+                       turbo=read('/sys/devices/system/cpu/intel_pstate/no_turbo'),
+                       boost=read('/sys/devices/system/cpu/cpufreq/boost'),
+                       perf_event_paranoid=read('/proc/sys/kernel/perf_event_paranoid'),
+                       exclusive_reservation=False)
+    # Hash untracked benchmark sources too: git diff does not contain them.
+    environment['source_hashes'] = {str(p.relative_to(ROOT)): hashlib.sha256(p.read_bytes()).hexdigest()
+                                    for directory in ['integrationtest/performance/backend/elasticsearch/src',
+                                                      'integrationtest/performance/backend/scripts', 'util/json/src']
+                                    for p in (ROOT / directory).rglob('*') if p.is_file()}
+    (args.out / 'environment.json').write_text(json.dumps(environment, indent=2) + '\n')
+    (args.out / 'command.txt').write_text(shlex.join(command) + '\n')
+    print(shlex.join(command), flush=True)
+    with (args.out / 'console.log').open('w') as output:
+        result = subprocess.run(command, cwd=ROOT, stdout=output, stderr=subprocess.STDOUT)
+    environment.update(load_after=read('/proc/loadavg'), pressure_after=read('/proc/pressure/cpu'),
+                       cpu_stat_after=read('/sys/fs/cgroup/cpu.stat'), exit_code=result.returncode)
+    (args.out / 'environment.json').write_text(json.dumps(environment, indent=2) + '\n')
+    # JMH can exit zero when individual forks fail.
+    results = json.loads((args.out / 'jmh.json').read_text())
+    console = (args.out / 'console.log').read_text()
+    if result.returncode or not results or '<failure>' in console or 'ERROR:' in console:
+        raise SystemExit('Benchmark failed; inspect console.log')
+    print(f'{len(results)} results in {args.out}', flush=True)
+
+
+if __name__ == '__main__':
+    main()
