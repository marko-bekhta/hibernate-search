+#!/usr/bin/env python3
+# SPDX-License-Identifier: Apache-2.0
+# Copyright Red Hat Inc. and Hibernate Authors
+"""Print primary scores and independent fork means; preserve original JMH uncertainty."""
+import argparse
+import csv
+import json
+import math
+from pathlib import Path
+import statistics
+import sys
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument('results', type=Path, nargs='+')
+args = parser.parse_args()
+writer = csv.writer(sys.stdout)
+writer.writerow(['run', 'benchmark', 'fixture', 'lifecycle', 'score', 'jmh_99.9_error',
+                 'units', 'fork_means', 'fork_cv_percent', 'allocation_B_per_op'])
+for path in args.results:
+    for result in json.loads(path.read_text()):
+        metric = result['primaryMetric']
+        means = [statistics.mean(fork) for fork in metric.get('rawData', [])]
+        cv = statistics.stdev(means) / statistics.mean(means) * 100 if len(means) > 1 else math.nan
+        writer.writerow([path.parent.name, result['benchmark'].split('.')[-1],
+                         result.get('params', {}).get('fixture', ''),
+                         result.get('params', {}).get('lifecycle', ''),
+                         metric['score'], metric['scoreError'], metric['scoreUnit'],
+                         ';'.join(f'{mean:.6g}' for mean in means), cv,
+                         result.get('secondaryMetrics', {}).get('gc.alloc.rate.norm', {}).get('score', '')])
