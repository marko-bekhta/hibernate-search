+	public static JsonNumber jsonNumber(String lexeme) {
+		int offset = lexeme.startsWith( "-" ) ? 1 : 0;
+		int length = lexeme.length();
+		if ( offset == length ) {
+			throw invalid( lexeme );
+		}
+		if ( lexeme.charAt( offset ) == '0' ) {
+			offset++;
+		}
+		else {
+			char digit = lexeme.charAt( offset );
+			if ( digit < '1' || digit > '9' ) {
